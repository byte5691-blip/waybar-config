{
    "layer": "top",
    "position": "top",

    "height": 46,

    "margin-top": 8,
    "margin-left": 12,
    "margin-right": 12,

    "spacing": 8,

    "modules-left": [
        "custom/firefox",
        "custom/code",
        "custom/steam",
        "cava",
        "hyprland/workspaces"
    ],

    "modules-center": [
        "custom/media",
        "clock"
    ],

    "modules-right": [
        "pulseaudio",
        "network",
        "battery"
    ],

       "custom/code": {
        "format": "󰨞",
        "tooltip": false,
        "on-click": "flatpak run com.visualstudio.code"
    },

    "custom/steam": {
    "format": "",
    "tooltip": false,
    "on-click": "flatpak run com.valvesoftware.Steam"
},

    "custom/firefox": {
        "format": "󰈹",
        "tooltip": false,
        "on-click": "firefox"
    },

    "hyprland/workspaces": {
        "format": "{name}",
        "disable-scroll": true,
        "all-outputs": true,

        "persistent-workspaces": {
            "1": [],
            "2": [],
            "3": [],
            "4": []
        }
    },

"cava": {
    "framerate": 60,
    "autosens": 1,
    "bars": 10,
    "lower_cutoff_freq": 50,
    "higher_cutoff_freq": 10000,

    "method": "pipewire",

    "source": "auto",

    "stereo": true,

    "reverse": false,

    "bar_delimiter": 0,

    "monstercat": false,

    "waves": false,

    "noise_reduction": 0.77,

    "input_delay": 2,

    "format-icons": [
        "▁",
        "▂",
        "▃",
        "▄",
        "▅",
        "▆",
        "▇",
        "█"
    ],

    "actions": {
        "on-click-right": "mode"
    }
},

    "custom/media": {
        "format": "  {}",
        "return-type": "json",

        "exec": "playerctl metadata --format '{\"text\": \"{{artist}} - {{title}}\"}'",

        "exec-if": "playerctl status",

        "interval": 2,

        "max-length": 35,

        "on-click": "playerctl play-pause",
        "on-scroll-up": "playerctl next",
        "on-scroll-down": "playerctl previous"
    },

    "clock": {
        "format": "  {:%H:%M}"
    },

    "pulseaudio": {
        "format": "  {volume}%",
        "format-muted": "󰝟 Muted",
        "on-click": "pavucontrol"
    },

    "network": {
        "format-wifi": "  {signalStrength}%",
        "format-ethernet": "󰈀 Ethernet",
        "format-disconnected": "󰖪 Offline"
    },

    "battery": {
        "format": "  {capacity}%",
        "format-charging": "󰂄  {capacity}%"
    }
}